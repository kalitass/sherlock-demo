# Copy to .env and edit. All settings are optional; defaults work for local use.

# Elasticsearch
SHERLOCK_ES_URL=http://localhost:9200

# ── LLM engine (bring-your-own-model) ───────────────────────────────────────
# Leave keys blank to run the deterministic engine (no API needed).
# Pick a provider; the compatibility layer knows each one's endpoint + key env
# var, so you usually only set PROVIDER + the matching key. See all of them with:
#   uv run python -m cli providers
#
# Provider        key env var(s)                   notes
# ----------      ----------------------------      -----------------------------
# anthropic       ANTHROPIC_API_KEY                 native Claude API
# openai          OPENAI_API_KEY
# azure           AZURE_OPENAI_API_KEY              also set SHERLOCK_LLM_BASE_URL
# groq            GROQ_API_KEY
# deepseek        DEEPSEEK_API_KEY
# together        TOGETHER_API_KEY
# openrouter      OPENROUTER_API_KEY
# mistral         MISTRAL_API_KEY
# xai             XAI_API_KEY                       (grok)
# gemini          GEMINI_API_KEY                    Google's OpenAI-compatible endpoint
# ollama          (none — local)                    runs http://localhost:11434
# lmstudio        (none — local)                    runs http://localhost:1234
# vllm            VLLM_API_KEY (optional, local)    runs http://localhost:8000

SHERLOCK_LLM_PROVIDER=anthropic
# SHERLOCK_LLM_MODEL=                 # leave blank to use the provider's default
SHERLOCK_LLM_TEMPERATURE=0.0
# SHERLOCK_LLM_BASE_URL=             # override the endpoint (Azure, a proxy, self-host)

# Engine behind the provider layer: auto (LiteLLM if installed, else native) |
# litellm (force LiteLLM: retries/timeouts/100+ providers) | native (hand-rolled
# anthropic/openai SDKs, minimal dependencies).
# SHERLOCK_LLM_ENGINE=auto
# SHERLOCK_LLM_TIMEOUT=60            # per-call timeout, seconds
# SHERLOCK_LLM_RETRIES=2            # transient-error retries per call
# If the LLM fails mid-hunt, Sherlock degrades to the deterministic engine (never crashes).

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# MCP backend used by the hunt engine: stdio (real MCP) | direct (in-process)
SHERLOCK_MCP_BACKEND=stdio

# Ports
SHERLOCK_DASHBOARD_PORT=8080
SHERLOCK_SYSLOG_PORT=5514
